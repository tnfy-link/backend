# Environment Configuration Template for tnfy.link backend
# Copy this file to .env and fill in your actual values
# This file contains all required environment variables with examples and documentation

# =============================================================================
# HTTP SERVER CONFIGURATION
# =============================================================================

# HTTP Listen Address
# Purpose: Address and port the HTTP server binds to
# Format: host:port (use :3000 to bind on all interfaces)
# Default: 127.0.0.1:3000
# Example: :3000
HTTP__ADDRESS=127.0.0.1:3000

# Trusted Proxy Header
# Purpose: Header used to determine the client IP when the server runs behind a proxy
# Format: HTTP header name
# Default: X-Forwarded-For
# Example: X-Forwarded-For
HTTP__PROXY_HEADER=X-Forwarded-For

# Trusted Proxies
# Purpose: Comma-separated proxies allowed to set the trusted proxy header
# Format: Comma-separated list of IP addresses or CIDR ranges; empty disables the setting
# Default: (empty)
# Example: 127.0.0.1
HTTP__PROXIES=

# =============================================================================
# API CONFIGURATION
# =============================================================================

# CORS Allowed Origins
# Purpose: Origins allowed to call the API; CORS middleware is disabled when empty
# Format: Comma-separated list of origins
# Default: (empty)
# Example: https://app.example.com
API__CORS_ALLOW_ORIGINS=

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================

# Redis Connection URL
# Purpose: Redis instance used to store links and the ID counter
# Format: Redis connection URL (redis://[user:password@]host:port/db)
# Default: redis://localhost:6379/0
# Example: redis://redis:6379/0
STORAGE__URL=redis://localhost:6379/0

# =============================================================================
# LINKS CONFIGURATION
# =============================================================================

# Link Hostname
# Purpose: Base hostname prepended to generated short IDs in API responses
# Format: URL
# Default: http://localhost:3001
# Example: https://tnfy.link
LINKS__HOSTNAME=http://localhost:3001

# Link Time-to-Live
# Purpose: Duration for which generated links remain valid
# Format: Go duration (e.g. 30m, 24h, 168h)
# Default: 168h
# Example: 168h
LINKS__TTL=168h

# ID Provider
# Purpose: Strategy used to generate short link IDs
# Format: random | combined
# Default: random
# Example: combined
ID__PROVIDER=random

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Debug Logging
# Purpose: Switches Zap to development logging when set to any non-empty value
# Format: Any non-empty value enables it; unset or empty keeps production logging
# Example: 1
DEBUG=
